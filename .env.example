# Required: public browser configuration for Supabase accounts. Restart after changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use true behind production HTTPS (including Vercel), false for local HTTP.
APP_HTTPS=false

# Optional: enables the Remove background button. Restart the server after changes.
PHOTOROOM_API_KEY=

# Optional: live camera try-on. The permanent key stays on the server.
DECART_API_KEY=

# Optional: daily outfit try-on (and separately invoked AI skills).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
# Legacy local tools only. The app uses each account's private uploaded reference photo.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
# Server-only database connection for applying Supabase migrations. Never use a VITE_ prefix.
SUPABASE_DB_URL=
# Optional path to your project's database CA certificate.
SUPABASE_DB_SSL_CA=
