# Optional: enables the Remove background button. Restart the server after changes.
PHOTOROOM_API_KEY=

# Optional: live camera try-on. The permanent key stays on the server.
DECART_API_KEY=

# Optional: daily outfit try-on (and separately invoked AI skills).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high



# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
